{
  "info": {
    "_postman_id": "6fbc00e1-d393-4d8a-8946-c3c932d2d771",
    "name": "Campus Events API",
    "description": "Cookie-authenticated API regression checks. Clear localhost cookies before each run and run requests in order. See documentation/postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "eventId", "value": "" },
    { "key": "registrationId", "value": "" }
  ],
  "event": [
    { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.environment.set('longTitle', 'X'.repeat(201));"] } }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Postman cookie jar must be enabled. Logins replace the jwt_token cookie for localhost.",
      "item": [
        { "name": "Current user requires cookie", "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('anonymous request returns 401', () => pm.response.to.have.status(401));"] } }] },
        { "name": "Anonymous mutation returns 401", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Cookie", "value": "jwt_token=" }], "body": { "mode": "raw", "raw": "{\"title\":\"Anonymous\",\"date\":\"2027-12-01\",\"time\":\"10:00\",\"location\":\"QA Lab\",\"category\":\"SEMINAR\",\"capacity\":1}" }, "url": "{{baseUrl}}/api/events" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('anonymous mutation returns 401', () => pm.response.to.have.status(401));"] } }] },
        { "name": "Tampered cookie returns 401", "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "jwt_token=tampered.invalid.cookie" }], "url": "{{baseUrl}}/api/auth/me" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('tampered cookie returns 401', () => pm.response.to.have.status(401));"] } }] },
        { "name": "Login as admin", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('login is 200', () => pm.response.to.have.status(200));", "pm.test('admin role returned', () => pm.expect(pm.response.json().role).to.eql('ADMIN'));", "pm.test('HttpOnly cookie set, no token in body', () => { pm.expect(pm.response.headers.get('Set-Cookie')).to.match(/jwt_token=.*HttpOnly/i); pm.expect(pm.response.text()).not.to.match(/\"token\"/i); });"] } }] },
        { "name": "Current user from cookie", "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('current user is admin', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().email).to.eql(pm.environment.get('adminEmail')); });"] } }] },
        { "name": "Bad credentials return generic 401", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"no-such-user@example.invalid\",\n  \"password\": \"WrongPassword123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('generic unauthorized response', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().message).to.eql('Invalid email or password'); });"] } }] },
        { "name": "Register new account", "event": [{ "listen": "prerequest", "script": { "exec": ["pm.environment.set('signupEmail', 'postman.qa.' + Date.now() + '@gmail.com');"] } }, { "listen": "test", "script": { "exec": ["pm.test('registration succeeds', () => pm.response.to.have.status(201));"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Postman Signup\",\"email\":\"{{signupEmail}}\",\"password\":\"Demo@12345\"}" }, "url": "{{baseUrl}}/api/auth/register" } },
        { "name": "Duplicate email returns 409", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Postman Signup Duplicate\",\"email\":\"{{signupEmail}}\",\"password\":\"Demo@12345\"}" }, "url": "{{baseUrl}}/api/auth/register" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('duplicate email returns 409', () => pm.response.to.have.status(409));"] } }] },
        { "name": "Logout", "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/logout" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('logout clears cookie', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Set-Cookie')).to.match(/Max-Age=0/i); });"] } }] },
        { "name": "Current user after logout", "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('logout invalidates session', () => pm.response.to.have.status(401));"] } }] }
      ]
    },
    {
      "name": "Events",
      "item": [
        { "name": "Login as admin for event checks", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{demoPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('admin login', () => pm.response.to.have.status(200));"] } }] },
        { "name": "List 12 public events", "request": { "method": "GET", "url": "{{baseUrl}}/api/events?page=0&size=12" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('page size and 555 seeded events', () => { pm.response.to.have.status(200); const p=pm.response.json(); pm.expect(p.size).to.eql(12); pm.expect(p.content).to.have.length(12); pm.expect(p.totalElements).to.eql(555); pm.expect(p).to.have.all.keys('content','page','size','totalElements','totalPages','first','last'); });"] } }] },
        { "name": "Get public event 1", "request": { "method": "GET", "url": "{{baseUrl}}/api/events/1" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('event found', () => pm.response.to.have.status(200));"] } }] },
        { "name": "Missing event returns 404", "request": { "method": "GET", "url": "{{baseUrl}}/api/events/999999" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('missing event', () => pm.response.to.have.status(404));"] } }] },
        { "name": "Login as student", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{studentEmail}}\",\"password\":\"{{demoPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('student login', () => { pm.response.to.have.status(200); pm.environment.set('studentUserId', String(pm.response.json().id)); });"] } }] },
        { "name": "Student cannot create event", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"title\":\"Forbidden\",\"date\":\"2027-12-01\",\"time\":\"10:00\",\"location\":\"QA Lab\",\"category\":\"SEMINAR\",\"capacity\":1}" }, "url": "{{baseUrl}}/api/events" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('student gets 403', () => pm.response.to.have.status(403));"] } }] },
        { "name": "Login as admin before create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{demoPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('admin login', () => pm.response.to.have.status(200));"] } }] },
        { "name": "Create temporary capacity-one event", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Postman QA Temporary Event\",\n  \"description\": \"Temporary collection test\",\n  \"date\": \"2027-12-01\",\n  \"time\": \"10:00\",\n  \"location\": \"QA Lab\",\n  \"category\": \"SEMINAR\",\n  \"capacity\": 1,\n  \"createdBy\": 999999\n}" }, "url": "{{baseUrl}}/api/events" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('created with id', () => { pm.response.to.have.status(201); pm.environment.set('eventId', String(pm.response.json().id)); });"] } }] },
        { "name": "Update temporary event", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"title\":\"Postman QA Temporary Event Updated\",\"date\":\"2027-12-01\",\"time\":\"11:00\",\"location\":\"QA Lab\",\"category\":\"WORKSHOP\",\"capacity\":1}" }, "url": "{{baseUrl}}/api/events/{{eventId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('owner update succeeds', () => pm.response.to.have.status(200));"] } }] },
        { "name": "Login as second admin", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{secondAdminEmail}}\",\"password\":\"{{demoPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('second admin login', () => pm.response.to.have.status(200));"] } }] },
        { "name": "Different admin cannot update owned event", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"title\":\"Unauthorized update\",\"date\":\"2027-12-01\",\"time\":\"11:00\",\"location\":\"QA Lab\",\"category\":\"WORKSHOP\",\"capacity\":1}" }, "url": "{{baseUrl}}/api/events/{{eventId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('other admin gets 403', () => pm.response.to.have.status(403));"] } }] },
        { "name": "Login as owner admin", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{demoPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('owner admin login', () => pm.response.to.have.status(200));"] } }] },
        { "name": "Invalid category returns 400", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"title\":\"Bad category\",\"date\":\"2027-12-01\",\"time\":\"10:00\",\"location\":\"QA Lab\",\"category\":\"INVALID\",\"capacity\":1}" }, "url": "{{baseUrl}}/api/events" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('invalid enum rejected', () => pm.response.to.have.status(400));"] } }] },
        { "name": "Lowercase category returns 400", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"title\":\"Bad case\",\"date\":\"2027-12-01\",\"time\":\"10:00\",\"location\":\"QA Lab\",\"category\":\"seminar\",\"capacity\":1}" }, "url": "{{baseUrl}}/api/events" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('lowercase enum rejected', () => pm.response.to.have.status(400));"] } }] },
        { "name": "Zero capacity returns 400", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"title\":\"Bad capacity\",\"date\":\"2027-12-01\",\"time\":\"10:00\",\"location\":\"QA Lab\",\"category\":\"SEMINAR\",\"capacity\":0}" }, "url": "{{baseUrl}}/api/events" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('capacity validated', () => pm.response.to.have.status(400));"] } }] },
        { "name": "Overlong title should be rejected (known bug)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"title\":\"{{longTitle}}\",\"date\":\"2027-12-01\",\"time\":\"10:00\",\"location\":\"QA Lab\",\"category\":\"SEMINAR\",\"capacity\":1}" }, "url": "{{baseUrl}}/api/events" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('overlong title should be 400; current backend returns 500', () => pm.response.to.have.status(400));"] } }] },
        { "name": "Overlong location should be rejected (known bug)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"title\":\"Valid title\",\"date\":\"2027-12-01\",\"time\":\"10:00\",\"location\":\"{{longTitle}}\",\"category\":\"SEMINAR\",\"capacity\":1}" }, "url": "{{baseUrl}}/api/events" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('overlong location should be 400; current backend returns 500', () => pm.response.to.have.status(400));"] } }] },
        { "name": "Malformed JSON returns 400", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"title\":" } , "url": "{{baseUrl}}/api/events" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('malformed JSON returns 400', () => pm.response.to.have.status(400));"] } }] }
      ]
    },
    {
      "name": "Registrations",
      "item": [
        { "name": "Login as student", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{studentEmail}}\",\"password\":\"{{demoPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('student login', () => pm.response.to.have.status(200));"] } }] },
        { "name": "Register current user (userId ignored)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"eventId\":{{eventId}},\"userId\":999999}" }, "url": "{{baseUrl}}/api/register" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('registration created', () => { pm.response.to.have.status(201); pm.environment.set('registrationId', String(pm.response.json().id)); });"] } }] },
        { "name": "Duplicate registration returns 409", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"eventId\":{{eventId}}}" }, "url": "{{baseUrl}}/api/register" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('duplicate blocked', () => pm.response.to.have.status(409));"] } }] },
        { "name": "List current user's registrations with ignored userId", "request": { "method": "GET", "url": "{{baseUrl}}/api/registrations?page=0&size=100&userId=999999" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('student scope is not widened by userId', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().content).to.be.an('array').that.is.not.empty; pm.response.json().content.forEach(r => pm.expect(String(r.userId)).to.eql(pm.environment.get('studentUserId'))); });"] } }] },
        { "name": "Login as different admin before registration delete check", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{secondAdminEmail}}\",\"password\":\"{{demoPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('second admin login for registration scope', () => pm.response.to.have.status(200));"] } }] },
        { "name": "Different admin cannot delete registration", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/registrations/{{registrationId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('different admin gets 403 for registration delete', () => pm.response.to.have.status(403));"] } }] },
        { "name": "Login as admin for full-event checks", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{demoPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('admin login', () => pm.response.to.have.status(200));"] } }] },
        { "name": "Admin registration scope does not widen", "request": { "method": "GET", "url": "{{baseUrl}}/api/registrations?eventId=999999&page=0&size=100" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('admin foreign event scope is empty', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().content).to.be.an('array').that.is.empty; });"] } }] },
        { "name": "Full event rejects second account", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"eventId\":{{eventId}}}" }, "url": "{{baseUrl}}/api/register" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('full event blocked', () => pm.response.to.have.status(409));"] } }], "description": "Log in as admin after the student has registered for the capacity-one event." },
        { "name": "Delete event with registration returns 409", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/events/{{eventId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('registered event retained', () => pm.response.to.have.status(409));"] } }], "description": "Run while the temporary event still has the student registration." },
        { "name": "Login as student to cancel", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{studentEmail}}\",\"password\":\"{{demoPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('student login', () => pm.response.to.have.status(200));"] } }] },
        { "name": "Cancel own registration", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/registrations/{{registrationId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('registration cancelled', () => pm.response.to.have.status(204));"] } }] },
        { "name": "Login as admin to clean up", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{demoPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('admin login', () => pm.response.to.have.status(200));"] } }] },
        { "name": "Delete temporary event after cancellation", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/events/{{eventId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('empty event deleted', () => pm.response.to.have.status(204));"] } }] },
        { "name": "Missing event registration returns 404", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"eventId\":999999}" }, "url": "{{baseUrl}}/api/register" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('unknown event rejected', () => pm.response.to.have.status(404));"] } }] },
        { "name": "Delete missing registration returns 404", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/registrations/999999" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('missing registration deletion returns 404', () => pm.response.to.have.status(404));"] } }] }
      ]
    },
    {
      "name": "Database",
      "description": "Database evidence is collected from MySQL CLI. Run: docker compose exec -T db mysql -ucampus -pcampus123 campus_events -e \"SELECT COUNT(*) FROM events; SELECT COUNT(*) FROM registrations; SELECT COUNT(*) FROM users;\". See README.md and database-checks.sql.",
      "item": []
    }
  ]
}
